{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.js",
      "**/*.mjs",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!.cloudflare"
    ]
  }
}
